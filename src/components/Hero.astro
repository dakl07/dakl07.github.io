---
// Hero section component
import { Image } from "astro:assets";
import logo from "../assets/dakl_logo_new_tp.png";
---

<section
    class="min-h-screen flex items-center justify-center px-4 py-12 bg-linear-to-t from-neutral-50 to-slate-300 dark:to-sky-800 dark:from-slate-950"
>
    <div class="text-center max-w-4xl mx-auto">
        <!-- Logo/Avatar -->

        <Image src={logo} alt="dakl logo" height={1000} class="mb-8" />

       

        <!-- CTA Button -->
        <div class="flex justify-center">
            <a
                href="#projects"
                class="inline-flex items-center px-8 py-4 bg-blue-600 hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600 text-white font-semibold rounded-xl transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl"
            >
                Meine Projekte
                <svg
                    class="ml-2 w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                </svg>
            </a>
        </div>
    </div>
</section>
